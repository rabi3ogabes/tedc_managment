# API base URL. In development the Vite dev server proxies /api to VITE_API_PROXY.
VITE_API_URL=/api/v1
VITE_API_PROXY=http://localhost:8000

# Optional: Supabase Realtime for live notifications
VITE_SUPABASE_URL=
# Publishable key only (sb_publishable_...). Never put the secret key in the web app.
VITE_SUPABASE_PUBLISHABLE_KEY=
