{
  "key": "json_post",
  "label": {
    "ar": "JSON عبر POST",
    "en": "JSON POST"
  },
  "description": {
    "ar": "طلب JSON إلى مسار واحد؛ النص كما هو (UTF-8)؛ يُعدّ الرد ناجحًا ما لم يحمل خطأ.",
    "en": "A JSON request to one path; the text as it is (UTF-8); accepted unless the answer carries an error."
  },
  "contract": {
    "system": "hudhud",
    "version": "1.0",
    "auth": {
      "type": "bearer",
      "setting": "api_key"
    },
    "errors": {
      "400": {
        "code": "rejected",
        "message": {
          "ar": "رفض النظام الطلب لأن بياناته غير صحيحة",
          "en": "The system rejected the request as invalid"
        }
      },
      "401": {
        "code": "unauthorised",
        "message": {
          "ar": "رفض النظام بيانات الاعتماد",
          "en": "The system refused the credentials"
        }
      },
      "403": {
        "code": "unauthorised",
        "message": {
          "ar": "لا يملك الحساب صلاحية لهذه العملية في النظام",
          "en": "The account is not allowed to do this in the system"
        }
      },
      "404": {
        "code": "not_found",
        "message": {
          "ar": "لا يوجد هذا السجل في النظام",
          "en": "The system has no such record"
        }
      },
      "409": {
        "code": "conflict",
        "message": {
          "ar": "يُبلغ النظام عن تعارض مع سجل موجود",
          "en": "The system reports a conflict with an existing record"
        }
      },
      "422": {
        "code": "rejected",
        "message": {
          "ar": "رفض النظام البيانات المرسلة",
          "en": "The system rejected the data sent"
        }
      },
      "429": {
        "code": "rate_limited",
        "retryable": true,
        "message": {
          "ar": "يطلب النظام التمهّل في الطلبات",
          "en": "The system asks to slow down"
        }
      },
      "5xx": {
        "code": "upstream_error",
        "retryable": true,
        "message": {
          "ar": "حدث خطأ في النظام الآخر",
          "en": "The system had an error"
        }
      }
    },
    "sms": {
      "encoding": "auto",
      "encoding_names": {
        "gsm7": "GSM7",
        "ucs2": "UCS2"
      },
      "unicode_as": "text"
    },
    "operations": {
      "send": {
        "title": {
          "ar": "إرسال رسالة نصية",
          "en": "Send a text message"
        },
        "method": "POST",
        "path": "{{ settings.send_path|default:/sms/send|raw }}",
        "body": {
          "format": "json",
          "template": {
            "from": "{{ settings.sender|default:TEDC }}",
            "to": "{{ to_plus }}",
            "text": "{{ text }}",
            "reference?": "{{ reference }}",
            "callback_url?": "{{ settings.receipt_url }}"
          }
        },
        "response": {
          "values": {
            "message_id": [
              "$.id",
              "$.message_id",
              "$.data.id"
            ],
            "status": [
              "$.status"
            ]
          },
          "error": "$.message"
        },
        "success_when": {
          "path": "$.error",
          "absent": true
        }
      }
    },
    "inbound": {
      "signature": {
        "header": "X-Signature",
        "algorithm": "hmac-sha256",
        "encoding": "hex",
        "payload": "{{ body }}",
        "secret_setting": "receipt_secret"
      },
      "receipt": {
        "records": "$.receipts"
      }
    }
  },
  "mapping": {
    "version": 1,
    "entities": {
      "receipt": {
        "fields": {
          "message_id": {
            "paths": [
              "$.message_id",
              "$.id"
            ]
          },
          "status": {
            "path": "$.status",
            "transform": [
              "lower",
              "table:status"
            ]
          },
          "reason": "$.reason"
        },
        "tables": {
          "status": {
            "delivered": "delivered",
            "failed": "failed",
            "undelivered": "failed",
            "rejected": "failed",
            "expired": "failed"
          }
        }
      }
    }
  }
}
