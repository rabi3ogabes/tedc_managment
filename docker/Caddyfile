{
	frankenphp
	admin off
	auto_https off
	# Plain HTTP behind the platform's TLS edge: HTTP/1.1 only, so the in-process HTTP/2 server is never reachable
	# (see .trivyignore for CVE-2026-78669 in the bundled golang.org/x/net).
	servers {
		protocols h1
	}
}

:{$PORT:8080} {
	root * /app/public
	encode zstd br gzip

	# Long-lived caching for fingerprinted Vite assets.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	php_server {
		# Existing files (assets, fonts, images) are served directly; everything else goes to Laravel,
		# which answers /api/* and returns the SPA shell for app pages.
		try_files {path} index.php
	}
}
