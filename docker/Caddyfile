{
	frankenphp
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /app/public
	encode zstd br gzip

	# Long-lived caching for fingerprinted Vite assets.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	php_server {
		# Existing files (assets, fonts, images) are served directly; everything else goes to Laravel,
		# which answers /api/* and returns the SPA shell for app pages.
		try_files {path} index.php
	}
}
